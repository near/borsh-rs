            tag_width: 1,
            variants: borsh::__private::maybestd::vec![
                (u8::from(0u8) as i64, ::core::convert::Into::into("B"), < A__B < K, V >
                as borsh::BorshSchema > ::declaration()), (u8::from(1u8) as i64,
                ::core::convert::Into::into("C"), < A__C < K > as borsh::BorshSchema >
                ::declaration())
            ],
        };
        borsh::schema::add_definition(
