#[automatically_derived]
impl borsh::de::BorshDeserializeBounded for X {
    fn deserialize_bounded_alloc<__R: borsh::io::Read>(
        reader: &mut __R,
        __budget: &mut borsh::de::Budget,
    ) -> ::core::result::Result<Self, borsh::io::Error> {
        let tag = <u8 as borsh::de::BorshDeserializeBounded>::deserialize_bounded_alloc(
            reader,
            __budget,
        )?;
        <Self as borsh::de::EnumExtBounded>::deserialize_variant_bounded_alloc(
            reader,
            tag,
            __budget,
        )
    }
}
#[automatically_derived]
impl borsh::de::EnumExtBounded for X {
    fn deserialize_variant_bounded_alloc<__R: borsh::io::Read>(
        reader: &mut __R,
        variant_tag: u8,
        __budget: &mut borsh::de::Budget,
    ) -> ::core::result::Result<Self, borsh::io::Error> {
        let mut return_value = if variant_tag == 0 {
            X::A
        } else if variant_tag == 20 {
            X::B
        } else if variant_tag == 20 + 1 {
            X::C
        } else if variant_tag == 20 + 1 + 1 {
            X::D
        } else if variant_tag == 10 {
            X::E
        } else if variant_tag == 10 + 1 {
            X::F
        } else {
            return Err(
                borsh::io::Error::new(
                    borsh::io::ErrorKind::InvalidData,
                    borsh::__private::maybestd::format!(
                        "Unexpected variant tag: {:?}", variant_tag
                    ),
                ),
            )
        };
        Ok(return_value)
    }
}
