where
    T: TraitName,
    V: borsh::ser::BorshSerialize,
    <T as TraitName>::Associated: borsh::ser::BorshSerialize,
{
    const ENCODES_TO_ZERO_BYTES: bool = {
        const fn __borsh_struct() {}
        __borsh_struct();
        borsh::__private::field_encodes_to_zero_bytes_ser(|__borsh_struct: &Self| {
            ::core::ptr::addr_of!(__borsh_struct.field)
        })
            && borsh::__private::field_encodes_to_zero_bytes_ser(|__borsh_struct: &Self| {
                ::core::ptr::addr_of!(__borsh_struct.another)
            })
    };
    fn serialize<__W: borsh::io::Write>(
        &self,
        writer: &mut __W,
    ) -> ::core::result::Result<(), borsh::io::Error> {
        borsh::BorshSerialize::serialize(&self.field, writer)?;
        borsh::BorshSerialize::serialize(&self.another, writer)?;
        ::core::result::Result::Ok(())
    }
}
